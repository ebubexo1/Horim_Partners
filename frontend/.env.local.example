# ============================================
# HORIM PARTNERS - Frontend Environment Variables
# Copy this file to .env.local for local dev.
# On Vercel, add these under Project Settings -> Environment Variables.
# ============================================

# URL of your deployed backend (Render), no trailing slash
NEXT_PUBLIC_API_URL=https://horim-partners-api.onrender.com/api

# Paystack PUBLIC key only (safe to expose in frontend) - only needed if you
# later add Paystack's inline.js popup checkout; the current flow redirects
# to Paystack's hosted checkout using the authorization_url from the backend,
# so this is optional for the MVP.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
