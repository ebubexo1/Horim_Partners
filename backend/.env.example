# ===== SERVER =====
PORT=5000
NODE_ENV=production

# ===== MONGODB =====
# Get this from MongoDB Atlas -> Connect -> Drivers
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/horim-partners?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string_here

# ===== AUTH =====
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ===== PAYSTACK =====
# From Paystack Dashboard -> Settings -> API Keys & Webhooks
# NEVER put the secret key in frontend code. It only lives here, on the server.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== FRONTEND URL (for CORS + Paystack callback redirect) =====
# Your deployed Vercel URL, e.g. https://horim-partners.vercel.app
CLIENT_URL=http://localhost:5173

# ===== ADMIN SEED (used only by `npm run seed`) =====
SUPER_ADMIN_EMAIL=admin@horimpartners.org
SUPER_ADMIN_PASSWORD=ChangeThisPassword123!
SUPER_ADMIN_NAME=Horim Super Admin
